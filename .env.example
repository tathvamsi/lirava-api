# External account connections. Keep this server-side only.
COMPOSIO_API_KEY=ak_...
# Required for encrypted user-managed project keys. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Public URLs used during OAuth redirects.
SOLI_BACKEND_URL=http://localhost:4000
SOLI_WEB_URL=http://localhost:3100

# Permit the web client to call this backend.
CORS_ORIGINS=http://localhost:3100

# Must match the web app's SESSION_SECRET so backend routes can validate the signed session cookie.
SESSION_SECRET=
