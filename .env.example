# ---------- Runtime ----------
NODE_ENV=production
PORT=4000
# Containers must listen on all interfaces; leave unset for local development (loopback only).
HOST=0.0.0.0
LOG_LEVEL=info
# Set to true ONLY when this service is reached solely through the Lirava web app / a trusted proxy.
# It then reads the visitor address from X-Forwarded-For, so sign-in rate limits apply per visitor.
TRUST_PROXY=true

# ---------- Required in production (the server refuses to start without these) ----------
# Random secret, at least 32 characters. MUST be identical in the web app.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# PostgreSQL: users, sessions and all chats are stored here.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Origin(s) of the web app, comma separated. No trailing slash.
CORS_ORIGINS=https://app.example.com
# OpenAI-compatible model server
CUSTOM_LLM_BASE_URL=http://llm-host:1618/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_EMBEDDING_MODEL=
# Administrators (comma separated). They get the admin role when they sign up, so signup must be gated (below).
ADMIN_EMAILS=partner@firm.com

# ---------- Who may create an account (set at least one, or ALLOW_OPEN_SIGNUP=true) ----------
SIGNUP_INVITE_CODES=
SIGNUP_ALLOWED_DOMAINS=
# ALLOW_OPEN_SIGNUP=true

# ---------- Legal corpus (vector search). Without Qdrant, answers carry no statute citations ----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=soli_legal_corpus
EMBEDDING_DIMENSIONS=1024
TOP_K=5
# Longest wait for the model / embedding / vector services before giving up (milliseconds)
UPSTREAM_TIMEOUT_MS=8000

# ---------- Answers ----------
# Answers generated at the same time: overall, and per user. The rest wait their turn.
MAX_CONCURRENT_RUNS=4
MAX_RUNS_PER_USER=2
# Characters of the user's own document excerpts put into a prompt (keep small for small models)
RAG_DOC_CHARS=2600

# ---------- Optional ----------
# Everything is stored in PostgreSQL. This folder is only read, once, to copy in data from an older installation
# that kept it in a local file (dots.db). A new installation does not need it; leave it unset.
# LEGACY_DATA_DIR=/data
MAX_UPLOAD_BYTES=26214400
# Connected apps (Composio) and encrypted per-user keys
COMPOSIO_API_KEY=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
SOLI_BACKEND_URL=https://api.example.com
SOLI_WEB_URL=https://app.example.com
